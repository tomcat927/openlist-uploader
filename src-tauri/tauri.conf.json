{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openlist-uploader",
  "version": "0.1.0",
  "identifier": "com.root.openlist-uploader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "openlist-uploader",
        "width": 800,
        "height": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NDI2N0ZENDJGQ0UwQTMKUldTajRQeEMvV2RDMTJoWUZFcDBiNldSU3E5dU1oVVdQbjlzRXowUzd0cUpiODRtRVYvTUN3eFUK",
      "endpoints": [
        "https://gh-proxy.org/https://github.com/tomcat927/openlist-uploader/releases/latest/download/latest.json",
        "https://github.com/tomcat927/openlist-uploader/releases/latest/download/latest.json"
      ]
    }
  }
}
